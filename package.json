{
  "name": "miracle-markdown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run wasm",
    "dev": "vite",
    "prebuild": "npm run wasm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "wasm": "cd crates/typeset-wasm && wasm-pack build --target web --out-dir pkg --release",
    "tauri": "tauri",
    "test": "cargo test -p typeset-core && cargo test -p miracle-markdown && npm run test:ts",
    "pretest:ts": "npm run wasm",
    "test:ts": "node test/run.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "mathjax-full": "^3.2.1"
  }
}
